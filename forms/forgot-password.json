{
  "id": "forgot-password-recovery",
  "version": "1.0.0",
  "title": {
    "en": "Reset Your Password",
    "ur": "پاس ورڈ دوبارہ ترتیب دیں"
  },
  "description": {
    "en": "3-step account recovery wizard with identity lookup, OTP verification, and strong password setup.",
    "ur": "تین مراحل میں اپنے اکاؤنٹ کی تصدیق کریں اور نیا پاس ورڈ منتخب کریں۔"
  },
  "defaults": {
    "channel": "email",
    "revokeOtherSessions": true
  },
  "steps": [
    {
      "id": "lookup",
      "title": "Find Account",
      "description": "Enter the email address or mobile number linked to your account.",
      "validateBeforeNext": true,
      "fields": [
        {
          "name": "accountIdentifier",
          "type": "emailOrPhone",
          "label": "Account Email or Mobile Number",
          "placeholder": "ahmad@1stfold.com or +92 300 1234567",
          "required": true
        },
        {
          "name": "channel",
          "type": "radioGroup",
          "label": "Where should we send the verification code?",
          "required": true,
          "options": [
            { "label": "Email Verification Code", "value": "email", "description": "Instant delivery to your inbox" },
            { "label": "SMS Text Message", "value": "sms", "description": "Sent to your verified mobile number" }
          ]
        }
      ]
    },
    {
      "id": "verify",
      "title": "Verify Code",
      "description": "Enter the 6-digit recovery code sent to your selected channel.",
      "validateBeforeNext": true,
      "fields": [
        {
          "name": "recoveryOtp",
          "type": "otp",
          "label": "6-Digit Recovery Code",
          "placeholder": "123456",
          "maxLength": 6,
          "required": true,
          "validation": {
            "regex": {
              "pattern": "^\\d{6}$",
              "message": "Enter a valid 6-digit numeric code"
            }
          }
        }
      ]
    },
    {
      "id": "new-password",
      "title": "New Password",
      "description": "Choose a strong unique password you have not used before.",
      "validateBeforeNext": true,
      "fields": [
        {
          "name": "newPassword",
          "type": "password",
          "label": "New Password",
          "placeholder": "Minimum 8 characters",
          "required": true,
          "showStrengthIndicator": true,
          "visibilityToggle": {
            "showIcon": "eye",
            "hideIcon": "eye-off"
          },
          "validation": {
            "password": {
              "minLength": 8,
              "requireUppercase": true,
              "requireLowercase": true,
              "requireNumber": true,
              "requireSpecialChar": true
            }
          }
        },
        {
          "name": "confirmNewPassword",
          "type": "confirmPassword",
          "label": "Confirm New Password",
          "passwordField": "newPassword",
          "required": true,
          "visibilityToggle": {
            "showIcon": "eye",
            "hideIcon": "eye-off"
          },
          "validation": {
            "equalsField": "newPassword",
            "messages": {
              "equalsField": "Passwords must match"
            }
          }
        },
        {
          "name": "revokeOtherSessions",
          "type": "switch",
          "label": "Sign out of all other active devices immediately"
        }
      ]
    }
  ],
  "submit": {
    "label": "Update Password",
    "loadingLabel": "Updating Password...",
    "successLabel": "Password Updated!",
    "showReset": true
  },
  "security": {
    "protectSensitiveFields": true,
    "clearSensitiveOnReset": true,
    "sensitiveFields": ["recoveryOtp", "newPassword", "confirmNewPassword"]
  }
}
